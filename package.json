{
  "name": "granttrace",
  "version": "0.0.0-dev",
  "description": "Test-bound GitHub App REST permission contracts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "granttrace": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./octokit": {
      "types": "./dist/octokit/index.d.ts",
      "import": "./dist/octokit/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "granttrace": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@octokit/core": "7.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
