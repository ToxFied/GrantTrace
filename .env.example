# Optional disposable live proof only. Never commit a populated copy.
GRANTTRACE_APP_ID=
GRANTTRACE_INSTALLATION_ID=
# Choose exactly one private-key provider.
GRANTTRACE_APP_PRIVATE_KEY_FILE=/absolute/path/to/disposable-app.private-key.pem
# macOS Keychain alternative:
# GRANTTRACE_APP_PRIVATE_KEY_KEYCHAIN_SERVICE=
# GRANTTRACE_APP_PRIVATE_KEY_KEYCHAIN_ACCOUNT=
# CI-only multiline-secret alternative:
# GRANTTRACE_APP_PRIVATE_KEY=
GRANTTRACE_LIVE_OWNER=
GRANTTRACE_LIVE_REPOSITORY=
GRANTTRACE_LIVE_ISSUE_NUMBER=
GRANTTRACE_LIVE_CONFIRM_DISPOSABLE=1
